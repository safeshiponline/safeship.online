# SafeShip India - Environment Variables
# Copy this file to .env.local for local testing and set these in Vercel Project Settings for production.

# Razorpay API Credentials (Get these from https://dashboard.razorpay.com -> Settings -> API Keys)
# For testing, you can use your Razorpay Test Key and Secret:
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere

# Optional Webhook Secret (Configured in Razorpay Dashboard -> Webhooks -> Add New Webhook)
# Webhook URL: https://<your-domain>/api/razorpay/webhook
# Secret: Your custom secret string
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# 3. Google Gemini AI Service (Strictly Server-Side - NEVER use NEXT_PUBLIC_ prefix)
# Supports official Google AI Studio API key (AIzaSy...) or an OpenAI-compatible proxy (Render, OpenRouter)
GEMINI_BASE_URL=https://gemini-proxy-xy1z.onrender.com/v1
GEMINI_API_KEY=cpa_sk_YourApiKeyHere
GEMINI_MODEL=gemini-3.8-flash

# 4. App URL (Auto-set on Vercel as VERCEL_URL)
NEXT_PUBLIC_APP_URL=https://safeship.online

# 5. PostHog Product Analytics & Session Replay
# Get your API key from PostHog Project Settings -> Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_YourPostHogKeyHere
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# 6. Resend Transactional Email Service (https://resend.com)
# Get your API key from Resend Dashboard -> API Keys
# When testing without a verified domain, you can send to your account email using onboarding@resend.dev
RESEND_API_KEY=re_YourResendApiKeyHere
RESEND_FROM_EMAIL=SafeShip India <notifications@safeship.online>
