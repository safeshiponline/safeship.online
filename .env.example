# SafeShip India - Environment Variables Reference
# Set these in your Vercel Project Settings (Settings -> Environment Variables)

# 1. Base App Domain
NEXT_PUBLIC_APP_URL=https://safeship.online

# 2. Google OAuth 2.0 (For 1-Tap & Instant Google Sign Up)
# In Google Cloud Console (https://console.cloud.google.com -> APIs & Services -> Credentials):
# Authorized JavaScript Origins: https://safeship.online and http://localhost:3000
# Authorized Redirect URIs: https://safeship.online/api/auth/google/callback and http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# 3. Session Signing Secret (Must be 32+ random characters)
AUTH_SECRET=your_super_secret_auth_token_key_min_32_characters

# 4. Cashfree Payments PG v3 (RBI-Compliant Payment Aggregator Escrow Rails)
# Get from Cashfree Merchant Dashboard (https://merchant.cashfree.com -> Developers -> API Keys)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
NEXT_PUBLIC_CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_ENV=production

# 5. Razorpay Gateway Credentials (Secondary / Fallback Rails)
# Get from Razorpay Dashboard (https://dashboard.razorpay.com -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id

# 6. Google Gemini Multimodal Vision API (For Instant IMEI & Optical Verification)
# Get from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIzaSyYourGoogleApiKey
GEMINI_MODEL=gemini-2.0-flash

# 7. Resend Transactional Email Engine (Welcome & Order Confirmation only)
# Get from Resend Dashboard (https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=SafeShip <updates@safeship.online>

# 8. PostHog Product Analytics (Optional)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
